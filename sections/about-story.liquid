{%- style -%}
  #AboutStory-{{ section.id }} {
    position: relative;
    padding: {{ section.settings.padding_top }}px 4% {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
  }

  #AboutStory-{{ section.id }} .story-grid {
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 64px;
    align-items: center;
    position: relative;
  }

  #AboutStory-{{ section.id }} .story-image-wrap {
    position: relative;
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
  }

  #AboutStory-{{ section.id }} .story-image-placeholder {
    position: relative;
    width: 100%;
    padding-top: {{ section.settings.image_aspect_ratio }};
    background-color: {{ section.settings.placeholder_bg }};
    background-image: repeating-linear-gradient(45deg, rgba(157, 190, 158, 0.27) 0 14px, transparent 14px 28px);
  }

  #AboutStory-{{ section.id }} .story-image-placeholder-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #AboutStory-{{ section.id }} .story-image-placeholder-label span {
    font-family: var(--body-font);
    font-size: 12px;
    color: {{ section.settings.placeholder_fg }};
    background: rgba(255, 255, 255, 0.85);
    padding: 6px 12px;
    border-radius: 20px;
  }

  #AboutStory-{{ section.id }} .story-image-wrap img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 20px;
  }

  #AboutStory-{{ section.id }} .story-title {
    font-family: var(--heading-font);
    font-weight: 700;
    color: {{ section.settings.title_color }};
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.1;
    margin: 0 0 18px;
    text-align: left;
  }

  #AboutStory-{{ section.id }} .story-body {
    font-size: 17px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
  }

  #AboutStory-{{ section.id }} .story-body p {
    margin: 0 0 16px;
  }

  #AboutStory-{{ section.id }} .story-body p:last-child {
    margin-bottom: 0;
  }

  @media(max-width:760px){
    #AboutStory-{{ section.id }} .story-grid {
      grid-template-columns: 1fr !important;
      gap: 32px;
    }
  }
{%- endstyle -%}

<section id="AboutStory-{{ section.id }}" data-screen-label="Story">
  <div class="story-grid">
    <div class="story-image-wrap">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.title }}
      {%- else -%}
        <div class="story-image-placeholder">
          <div class="story-image-placeholder-label">
            <span>{{ section.settings.placeholder_label }}</span>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div>
      {%- if section.settings.title != blank -%}
        <h2 class="story-title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.story_text != blank -%}
        <div class="story-body p">
          {{ section.settings.story_text }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Story",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story Image"
    },
    {
      "type": "text",
      "id": "image_aspect_ratio",
      "label": "Placeholder Aspect Ratio",
      "default": "118%"
    },
    {
      "type": "color",
      "id": "placeholder_bg",
      "label": "Placeholder Background Color",
      "default": "#DCEAD2"
    },
    {
      "type": "color",
      "id": "placeholder_fg",
      "label": "Placeholder Foreground Color",
      "default": "#9DBE9E"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder Label",
      "default": "Familie beim Essen"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Du möchtest alles richtig machen."
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#197D25"
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story Text",
      "default": "<p>Völlig verständlich – schließlich geht es um das Wertvollste, das du hast. Ein kleines, einzigartiges Leben, das du beschützt und für das du nur das Beste willst.</p><p>Genau aus diesem Gefühl heraus ist Elsis entstanden: Als Eltern haben wir gesucht – nach Babynahrung, die biologisch <em>und</em> halal ist, ohne Kompromisse. Als wir nichts fanden, das unseren Ansprüchen genügte, haben wir es selbst gemacht.</p><p>Heute steht Elsis für vollwertige Bio-Mahlzeiten im praktischen Beutel – entwickelt und hergestellt in Deutschland von Kaya Foods. <strong>Elsis – klein anfangen.</strong></p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3D6344"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "About Story"
    }
  ]
}
{% endschema %}
