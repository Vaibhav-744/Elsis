{%- style -%}
  #ContactHero-{{ section.id }} {
    position: relative;
    padding: {{ section.settings.padding_top }}px 4% {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
  }

  #ContactHero-{{ section.id }} .contact-hero-pattern {
    position: absolute;
    inset: 0;
    opacity: {{ section.settings.pattern_opacity | divided_by: 100.0 }};
    pointer-events: none;
    background-image: radial-gradient({{ section.settings.pattern_color_1 }} 2.2px, transparent 2.3px), radial-gradient({{ section.settings.pattern_color_2 }} 2.2px, transparent 2.3px);
    background-size: 38px 38px, 38px 38px;
    background-position: 0 0, 19px 19px;
    display: block;
  }

  #ContactHero-{{ section.id }} .contact-hero-cloud {
    position: absolute;
    top: 56px;
    left: 7%;
    width: 150px;
    height: 54px;
    background: #fff;
    border-radius: 50px;
    opacity: 0.7;
    box-shadow: 46px 8px 0 -6px #fff, -30px 10px 0 -8px #fff;
    display: block;
  }

  #ContactHero-{{ section.id }} .hero-container {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }

  #ContactHero-{{ section.id }} .contact-breadcrumbs {
    font-size: 13px;
    color: {{ section.settings.breadcrumb_color }};
    font-weight: 700;
    margin-bottom: 10px;
  }

  #ContactHero-{{ section.id }} .contact-breadcrumbs a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }

  #ContactHero-{{ section.id }} .contact-breadcrumbs a:hover {
    color: {{ section.settings.breadcrumb_active_color }};
  }

  #ContactHero-{{ section.id }} .contact-breadcrumbs span {
    color: {{ section.settings.breadcrumb_active_color }};
  }

  #ContactHero-{{ section.id }} .contact-hero-title {
    font-family: var(--heading-font);
    font-weight: 700;
    color: {{ section.settings.title_color }};
    font-size: clamp(52px, 9vw, 110px);
    line-height: .88;
    margin: 0;
  }

  #ContactHero-{{ section.id }} .contact-hero-text {
    font-size: 17px;
    color: {{ section.settings.text_color }};
    max-width: 520px;
    margin: 20px auto 0;
    line-height: 1.55;
  }
{%- endstyle -%}

<section id="ContactHero-{{ section.id }}" data-screen-label="KontaktHero">
  {%- if section.settings.show_pattern -%}
    <div class="contact-hero-pattern"></div>
  {%- endif -%}
  
  {%- if section.settings.show_clouds -%}
    <div class="contact-hero-cloud"></div>
  {%- endif -%}

  <div class="hero-container">
    {%- if section.settings.show_breadcrumbs -%}
      <div class="contact-breadcrumbs">
        <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home_text }}</a> › <span>{{ section.settings.breadcrumb_current_text }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="contact-hero-title">{{ section.settings.title }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="contact-hero-text">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact Hero",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F8F2E8"
    },
    {
      "type": "checkbox",
      "id": "show_pattern",
      "label": "Show Background Pattern",
      "default": true
    },
    {
      "type": "color",
      "id": "pattern_color_1",
      "label": "Pattern Color 1",
      "default": "#6ab37a"
    },
    {
      "type": "color",
      "id": "pattern_color_2",
      "label": "Pattern Color 2",
      "default": "#197925"
    },
    {
      "type": "range",
      "id": "pattern_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Pattern Opacity",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "show_clouds",
      "label": "Show Cloud Decoration",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show Breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb_home_text",
      "label": "Home Link Text",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "breadcrumb_current_text",
      "label": "Current Page Text",
      "default": "Kontakt"
    },
    {
      "type": "color",
      "id": "breadcrumb_color",
      "label": "Breadcrumb Base Color",
      "default": "#6AB37A"
    },
    {
      "type": "color",
      "id": "breadcrumb_active_color",
      "label": "Breadcrumb Active Color",
      "default": "#197D25"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "sprich<br>mit uns"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#197D25"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description Text",
      "default": "Fragen zu Bestellung, Zutaten oder Beikost? Wir sind für dich da – als Eltern und als Team."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#5C7A60"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Contact Hero"
    }
  ]
}
{% endschema %}
