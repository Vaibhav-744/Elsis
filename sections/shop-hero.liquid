{%- style -%}
  #ShopHero-{{ section.id }} {
    position: relative;
    padding: {{ section.settings.padding_top }}px 4% {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
  }

  #ShopHero-{{ section.id }} .shop-hero-pattern {
    position: absolute;
    inset: 0;
    opacity: {{ section.settings.pattern_opacity | divided_by: 100.0 }};
    pointer-events: none;
    background-image: radial-gradient({{ section.settings.pattern_color_1 }} 2.2px, transparent 2.3px), radial-gradient({{ section.settings.pattern_color_2 }} 2.2px, transparent 2.3px);
    background-size: 38px 38px, 38px 38px;
    background-position: 0 0, 19px 19px;
    display: block;
  }

  #ShopHero-{{ section.id }} .shop-hero-cloud {
    position: absolute;
    top: 60px;
    right: 8%;
    width: 130px;
    height: 46px;
    background: #fff;
    border-radius: 50px;
    opacity: 0.6;
    box-shadow: 40px 6px 0 -6px #fff, -26px 8px 0 -8px #fff;
    display: block;
  }

  #ShopHero-{{ section.id }} .hero-container {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }

  #ShopHero-{{ section.id }} .shop-breadcrumbs {
    font-size: 13px;
    color: {{ section.settings.breadcrumb_color }};
    font-weight: 700;
    margin-bottom: 10px;
  }

  #ShopHero-{{ section.id }} .shop-breadcrumbs a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }

  #ShopHero-{{ section.id }} .shop-breadcrumbs a:hover {
    color: {{ section.settings.breadcrumb_active_color }};
  }

  #ShopHero-{{ section.id }} .shop-breadcrumbs span {
    color: {{ section.settings.breadcrumb_active_color }};
  }

  #ShopHero-{{ section.id }} .shop-hero-title {
    font-family: var(--heading-font);
    font-weight: 700;
    color: {{ section.settings.title_color }};
    font-size: clamp(52px, 9vw, 110px);
    line-height: .88;
    margin: 0;
  }

  #ShopHero-{{ section.id }} .shop-hero-text {
    font-size: 17px;
    color: {{ section.settings.text_color }};
    max-width: 520px;
    margin: 18px auto 0;
    line-height: 1.55;
  }

  #ShopHero-{{ section.id }} .elsis-shop-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-top: 28px;
  }

  #ShopHero-{{ section.id }} .elsis-shop-pill {
    cursor: pointer;
    border: 1.5px solid rgba(25, 125, 37, 0.35);
    background: #fff;
    color: #197D25;
    font-family: var(--heading-font);
    font-weight: 600;
    font-size: 15px;
    padding: 10px 22px;
    border-radius: 24px 28px 22px 26px / 28px 22px 26px 24px;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }

  #ShopHero-{{ section.id }} .elsis-shop-pill.active {
    border-color: #197D25;
    background: #197D25;
    color: #fff;
  }
{%- endstyle -%}

<section id="ShopHero-{{ section.id }}" data-screen-label="ShopHero">
  {%- if section.settings.show_pattern -%}
    <div class="shop-hero-pattern"></div>
  {%- endif -%}
  
  {%- if section.settings.show_clouds -%}
    <div class="shop-hero-cloud"></div>
  {%- endif -%}

  <div class="hero-container">
    {%- if section.settings.show_breadcrumbs -%}
      <div class="shop-breadcrumbs">
        <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home_text }}</a> › <span>{{ section.settings.breadcrumb_current_text }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="shop-hero-title">{{ section.settings.title }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="shop-hero-text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="elsis-shop-filter">
        {%- for block in section.blocks -%}
          <button class="elsis-shop-pill{% if forloop.first %} active{% endif %}" data-filter="{{ block.settings.filter_value | escape }}" {{ block.shopify_attributes }}>
            {{ block.settings.label | escape }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
function initShopHero() {
  const pills = document.querySelectorAll('.elsis-shop-pill');
  pills.forEach(pill => {
    if (pill.dataset.filterInit) return;
    pill.dataset.filterInit = 'true';

    pill.addEventListener('click', function(e) {
      e.preventDefault();
      pills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');

      const filter = pill.getAttribute('data-filter');
      const cards = document.querySelectorAll('.elsis-card');
      
      cards.forEach(card => {
        const cardAge = card.getAttribute('data-age-group');
        const isAll = (!filter || filter === 'alle' || filter === 'all' || filter === 'all-sorten');
        
        if (isAll) {
          card.style.setProperty('display', 'flex', 'important');
        } else {
          const cleanAge = cardAge ? cardAge.trim().toLowerCase() : '';
          const cleanFilter = filter ? filter.trim().toLowerCase() : '';
          
          if (cleanAge !== '' && cleanFilter !== '' && (cleanAge.indexOf(cleanFilter) !== -1 || cleanFilter.indexOf(cleanAge) !== -1)) {
            card.style.setProperty('display', 'flex', 'important');
          } else {
            card.style.setProperty('display', 'none', 'important');
          }
        }
      });
    });
  });
}

initShopHero();
document.addEventListener('DOMContentLoaded', initShopHero);
document.addEventListener('shopify:section:load', initShopHero);
</script>

{% schema %}
{
  "name": "Shop Hero",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F8F2E8"
    },
    {
      "type": "checkbox",
      "id": "show_pattern",
      "label": "Show Background Pattern",
      "default": true
    },
    {
      "type": "color",
      "id": "pattern_color_1",
      "label": "Pattern Color 1",
      "default": "#6ab37a"
    },
    {
      "type": "color",
      "id": "pattern_color_2",
      "label": "Pattern Color 2",
      "default": "#197925"
    },
    {
      "type": "range",
      "id": "pattern_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Pattern Opacity",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "show_clouds",
      "label": "Show Clouds",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show Breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb_home_text",
      "label": "Home Link Text",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "breadcrumb_current_text",
      "label": "Current Page Text",
      "default": "Produkte"
    },
    {
      "type": "color",
      "id": "breadcrumb_color",
      "label": "Breadcrumb Base Color",
      "default": "#6AB37A"
    },
    {
      "type": "color",
      "id": "breadcrumb_active_color",
      "label": "Breadcrumb Active Color",
      "default": "#197D25"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "unsere<br>Produkte"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#197D25"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Fünf Bio-Rezepturen und ein Probierpaket – halal, ohne unnötige Zusätze und im 100% recycelbaren Beutel."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#5C7A60"
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 34
    }
  ],
  "blocks": [
    {
      "type": "filter_pill",
      "name": "Filter Pill",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Filter Button Label",
          "default": "Filter Label"
        },
        {
          "type": "text",
          "id": "filter_value",
          "label": "Filter Value (metafield value, e.g. 4, 6, 8, or alle)",
          "default": "alle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop Hero",
      "blocks": [
        {
          "type": "filter_pill",
          "settings": {
            "label": "Alle Sorten",
            "filter_value": "alle"
          }
        },
        {
          "type": "filter_pill",
          "settings": {
            "label": "ab 4. Monat",
            "filter_value": "4"
          }
        },
        {
          "type": "filter_pill",
          "settings": {
            "label": "ab 6. Monat",
            "filter_value": "6"
          }
        },
        {
          "type": "filter_pill",
          "settings": {
            "label": "ab 8. Monat",
            "filter_value": "8"
          }
        }
      ]
    }
  ]
}
{% endschema %}
