{%- style -%}
  #ElsisAnnouncement-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.font_size }}px;
  }

  #ElsisAnnouncement-{{ section.id }} .announcement-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 4%;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
  }

  #ElsisAnnouncement-{{ section.id }} .announcement-left {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 600;
    padding: {{ section.settings.padding_y }}px 0;
    border-right: .5px solid {{ section.settings.border_color }};
    padding-right: 18px;
  }

  #ElsisAnnouncement-{{ section.id }} .announcement-left svg {
    flex: none;
    stroke: {{ section.settings.text_color }};
    fill:none;
    height:20px;
    width:20px;
  }

  #ElsisAnnouncement-{{ section.id }} .announcement-left-text {
    white-space: nowrap;
  }

  #ElsisAnnouncement-{{ section.id }} .announcement-right-links {
    display: flex;
    align-items: stretch;
    font-weight: 600;
  }

  #ElsisAnnouncement-{{ section.id }} .announcement-link {
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_y }}px 18px;
    border-left: .5px solid {{ section.settings.border_color }};
    display: flex;
    align-items: center;
    transition: opacity 0.2s;
  }

  #ElsisAnnouncement-{{ section.id }} .announcement-link:hover {
    opacity: 0.75;
  }

  #ElsisAnnouncement-{{ section.id }} .announcement-truck-icon {
    flex: none !important;
  }

  @media(max-width: 960px) {
    #ElsisAnnouncement-{{ section.id }} .announcement-right-links {
      display: none !important;
    }
    #ElsisAnnouncement-{{ section.id }} .announcement-left {
      border-right: none !important;
      padding-right: 0;
      justify-content: center;
      width: 100%;
    }
  }
{%- endstyle -%}

<div id="ElsisAnnouncement-{{ section.id }}" class="elsis-announcement-bar">
  <div class="announcement-container">
    
    <div class="announcement-left">
      {%- if section.settings.show_truck_icon -%}
        <svg class="announcement-truck-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 4h13v11H1zM14 8h4l3 3v4h-7"></path><circle cx="6.5" cy="18" r="1.6"></circle><circle cx="17.5" cy="18" r="1.6"></circle></svg>
      {%- endif -%}
      {%- if section.settings.left_text != blank -%}
        <span class="announcement-left-text">{{ section.settings.left_text }}</span>
      {%- endif -%}
    </div>

    <div class="announcement-right-links">
      {%- for block in section.blocks -%}
        {%- if block.settings.title != blank -%}
          <a class="announcement-link" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
            {{ block.settings.title | escape }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Elsis Announcement Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#6AB37A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Separator Line Color",
      "default": "rgba(255, 255, 255, 0.4)"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 13,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "left_text",
      "label": "Left Message Text",
      "default": "Werktags bestellt · Versand in 24 Stunden"
    },
    {
      "type": "checkbox",
      "id": "show_truck_icon",
      "label": "Show Truck Icon",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 9,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Link Label",
          "default": "Link Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Elsis Announcement Bar",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "title": "Blog"
          }
        },
        {
          "type": "link",
          "settings": {
            "title": "Häufige Fragen"
          }
        },
        {
          "type": "link",
          "settings": {
            "title": "Händlersuche"
          }
        }
      ]
    }
  ]
}
{% endschema %}
