      "default": "#3D6344"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Marquee Speed (Seconds)",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 34,
      "unit": "s"
    },
    {
      "type": "range",
      "id": "padding_top",
