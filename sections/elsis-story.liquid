{%- style -%}
  #ElsisStory-{{ section.id }} {
    position: relative;
    padding: {{ section.settings.padding_top }}px 5% {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
  }

  #ElsisStory-{{ section.id }} .story-cloud {
    position: absolute;
    top: 50px;
    right: 7%;
    width: 140px;
    height: 50px;
    background: #fff;
    border-radius: 50px;
    opacity: 0.7;
    box-shadow: 42px 8px 0 -6px #fff, -28px 10px 0 -8px #fff;
  }

  #ElsisStory-{{ section.id }} .story-grid {
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 64px;
    align-items: center;
    position: relative;
  }

  #ElsisStory-{{ section.id }} .story-image-wrap {
    position: relative;
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
  }

  #ElsisStory-{{ section.id }} .story-image-placeholder {
    position: relative;
    width: 100%;
    padding-top: 118%;
    background-color: #DCEAD2;
    background-image: repeating-linear-gradient(45deg, rgba(157,190,158,0.27) 0 14px, transparent 14px 28px);
  }

  #ElsisStory-{{ section.id }} .story-image-placeholder-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #ElsisStory-{{ section.id }} .story-image-placeholder-label span {
    font-family: var(--body-font);
    font-size: 12px;
    color: #9DBE9E;
    background: rgba(255,255,255,0.85);
    padding: 6px 12px;
    border-radius: 20px;
  }

  #ElsisStory-{{ section.id }} .story-image-wrap img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  #ElsisStory-{{ section.id }} .story-text-container {
    text-align: left;
  }

  #ElsisStory-{{ section.id }} .story-title {
    color: {{ section.settings.title_color }} !important;
    text-align: left !important;
    margin: 0 !important;
  }

  #ElsisStory-{{ section.id }} .story-title-span-1 {
    display: block !important;
  }

  #ElsisStory-{{ section.id }} .story-title-span-2 {
    display: block !important;
    margin-top: 4px !important;
    margin-bottom: 8px !important;
  }

  #ElsisStory-{{ section.id }} .story-subtitle {
    font-family: var(--heading-font);
    font-weight: 500;
    color: {{ section.settings.subtitle_color }};
    font-size: 15px;
    margin-bottom: 20px;
  }

  #ElsisStory-{{ section.id }} .story-body {
    margin-bottom: 28px;
    color: {{ section.settings.body_color }};
  }

  #ElsisStory-{{ section.id }} .story-body p {
    margin: 0 0 16px;
  }

  #ElsisStory-{{ section.id }} .story-body p:last-child {
    margin-bottom: 0;
  }

  #ElsisStory-{{ section.id }} .elsis-story-cta {
    display: inline-block;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    font-family: var(--heading-font);
    font-weight: 600;
    font-size: 17px;
    padding: 14px 30px;
    border-radius: 28px 32px 26px 30px / 32px 26px 30px 28px;
    transition: transform .2s ease;
  }

  #ElsisStory-{{ section.id }} .elsis-story-cta:hover {
    transform: scale(1.06) rotate(-2deg);
  }

  @media(max-width:760px){
    #ElsisStory-{{ section.id }} .story-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
{%- endstyle -%}

<section id="ElsisStory-{{ section.id }}" data-screen-label="Geschichte">
  {%- if section.settings.show_clouds -%}
    <div class="story-cloud"></div>
  {%- endif -%}

  <div class="story-grid">
    <div class="story-image-wrap">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.title_1 }}
      {%- else -%}
        <div class="story-image-placeholder">
          <div class="story-image-placeholder-label">
            <span>Eltern &amp; Baby</span>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="story-text-container">
      {%- if section.settings.title_1 != blank or section.settings.title_2 != blank -%}
        <h2 class="h2 story-title">
          {%- if section.settings.title_1 != blank -%}
            <span class="story-title-span-1">{{ section.settings.title_1 }}</span>
          {%- endif -%}
          {%- if section.settings.title_2 != blank -%}
            <span class="story-title-span-2">{{ section.settings.title_2 }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <div class="story-subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}

      {%- if section.settings.story_text != blank -%}
        <div class="story-body p">
          {{ section.settings.story_text }}
        </div>
      {%- endif -%}

      {%- if section.settings.btn_text != blank -%}
        <a class="elsis-story-cta" href="{{ section.settings.btn_link | default: '#werte' }}">
          {{ section.settings.btn_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Elsis Our Story",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F8F2E8"
    },
    {
      "type": "checkbox",
      "id": "show_clouds",
      "label": "Show Cloud Background Decorator",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story Image"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Title Line 1",
      "default": "unsere"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Title Line 2",
      "default": "Geschichte"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Headline Color",
      "default": "#197D25"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle / Year Label",
      "default": "seit 2024"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#6AB37A"
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story Description",
      "default": "<p>Du möchtest alles richtig machen. Völlig verständlich – schließlich geht es um das Wertvollste, das du hast. Ein kleines, einzigartiges Leben, das du beschützt und für das du nur das Beste willst.</p><p>Deshalb gibt es Elsis. Wir helfen Eltern – Schritt für Schritt, in kleinen Portionen. Und dieser kleine Schritt ist bei uns der erste Löffel. Aus einem kleinen Beutel, mit dem dein Kind neue Geschmäcker entdeckt. <strong>Elsis – klein anfangen.</strong></p>"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#3D6344"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Mehr über uns"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background Color",
      "default": "#FFD42E"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#115A1B"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 96,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 96,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Elsis Our Story"
    }
  ]
}
{% endschema %}
