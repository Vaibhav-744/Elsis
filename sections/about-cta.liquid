{%- style -%}
  #AboutCTA-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 4% {{ section.settings.padding_bottom }}px;
  }

  #AboutCTA-{{ section.id }} .cta-container {
    max-width: 1240px;
    margin: 0 auto;
    text-align: center;
  }

  #AboutCTA-{{ section.id }} .cta-title {
    font-family: var(--heading-font);
    font-weight: 700;
    color: {{ section.settings.title_color }};
    font-size: clamp(32px, 5vw, 60px);
    line-height: .95;
    margin: 0 0 26px;
  }

  #AboutCTA-{{ section.id }} .elsis-cta {
    display: inline-block;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    font-family: var(--heading-font);
    font-weight: 600;
    font-size: 19px;
    padding: 16px 38px;
    border-radius: 30px 34px 28px 32px / 34px 28px 32px 30px;
    text-decoration: none;
    transition: transform .2s ease;
  }

  #AboutCTA-{{ section.id }} .elsis-cta:hover {
    transform: scale(1.06) rotate(-2deg);
  }
{%- endstyle -%}

<section id="AboutCTA-{{ section.id }}">
  <div class="cta-container">
    {%- if section.settings.title != blank -%}
      <h2 class="cta-title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.btn_text != blank -%}
      <a class="elsis-cta" href="{{ section.settings.btn_link | default: routes.all_products_collection_url }}">
        {{ section.settings.btn_text }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About CTA Section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "neugierig geworden?"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#197D25"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Sorten entdecken"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background Color",
      "default": "#FFD42E"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#115A1B"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 70
    }
  ],
  "presets": [
    {
      "name": "About CTA Section"
    }
  ]
}
{% endschema %}
