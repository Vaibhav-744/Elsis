{%- style -%}
  #AboutQuote-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 4% {{ section.settings.padding_bottom }}px;
    background-color:{{ section.settings.bg_color}};
  }

  #AboutQuote-{{ section.id }} .quote-card {
    max-width: 1170px;
    margin: 0 auto;
    background-color: {{ section.settings.card_bg_color }};
    border-radius: {{ section.settings.border_radius }}px;
    padding: 70px 8%;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  #AboutQuote-{{ section.id }} .quote-circle-1 {
    position: absolute;
    top: -50px;
    left: -30px;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background-color: {{ section.settings.circle_1_color }};
    opacity: {{ section.settings.circle_1_opacity | divided_by: 100.0 }};
    display:block;
  }

  #AboutQuote-{{ section.id }} .quote-circle-2 {
    position: absolute;
    bottom: -60px;
    right: -20px;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background-color: {{ section.settings.circle_2_color }};
    opacity: {{ section.settings.circle_2_opacity | divided_by: 100.0 }};
    display:block;
  }

  #AboutQuote-{{ section.id }} .quote-content {
    position: relative;
    z-index: 2;
  }

  #AboutQuote-{{ section.id }} .quote-text {
    font-family: var(--heading-font);
    font-weight: 700;
    color: {{ section.settings.quote_color }};
    font-size: {{ section.settings.quote_font_size }};
    line-height: 1.15;
    margin: 0 0 14px;
  }

  #AboutQuote-{{ section.id }} .quote-author {
    font-size: 15px;
    color: {{ section.settings.author_color }};
  }
{%- endstyle -%}

<section id="AboutQuote-{{ section.id }}">
  <div class="quote-card">
    <div class="quote-circle-1"></div>
    <div class="quote-circle-2"></div>
    
    <div class="quote-content">
      {%- if section.settings.quote != blank -%}
        <p class="quote-text">{{ section.settings.quote }}</p>
      {%- endif -%}
      {%- if section.settings.author != blank -%}
        <div class="quote-author">{{ section.settings.author }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Quote Card",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F8F2E8"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#197D25"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Border Radius",
      "default": 28
    },
    {
      "type": "color",
      "id": "circle_1_color",
      "label": "Circle 1 Color",
      "default": "#FFD42E"
    },
    {
      "type": "range",
      "id": "circle_1_opacity",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "label": "Circle 1 Opacity",
      "default": 14
    },
    {
      "type": "color",
      "id": "circle_2_color",
      "label": "Circle 2 Color",
      "default": "#F8F2E8"
    },
    {
      "type": "range",
      "id": "circle_2_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Circle 2 Opacity",
      "default": 7
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote Text",
      "default": "„Wir füttern unsere eigenen Kinder damit.<br>Das ist unser Qualitätsversprechen.\""
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "quote_font_size",
      "label": "Quote Font Size (CSS)",
      "default": "clamp(26px,4vw,46px)"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author/Subtext",
      "default": "Das Team von Elsis · Kaya Foods"
    },
    {
      "type": "color",
      "id": "author_color",
      "label": "Author/Subtext Color",
      "default": "#B9D2BF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 70
    }
  ],
  "presets": [
    {
      "name": "About Quote Card"
    }
  ]
}
{% endschema %}
