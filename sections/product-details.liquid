{%- style -%}
  #ProductDetails-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 4% {{ section.settings.padding_bottom }}px;
  }

  #ProductDetails-{{ section.id }} .details-container {
    max-width: 820px;
    margin: 0 auto;
  }

  #ProductDetails-{{ section.id }} .details-title {
    font-family: var(--heading-font);
    font-weight: 700;
    color: {{ section.settings.title_color }};
    font-size: clamp(26px, 3.5vw, 38px);
    margin: 0 0 22px;
    text-align: left;
  }

  #ProductDetails-{{ section.id }} .elsis-faq-item {
    border-bottom: 1px solid color-mix(in srgb,  #197D25 40%, transparent);
  }

  #ProductDetails-{{ section.id }} .elsis-faq-q {
    width: 100%;
    cursor: pointer;
    background: none;
    border: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    text-align: left;
    font-family: var(--heading-font);
    font-weight: 600;
    font-size: 18px;
    color: #197D25;
    outline: none;
  }

  #ProductDetails-{{ section.id }} .elsis-faq-ic {
    flex: none;
    font-size: 26px;
    color: #6AB37A;
    transition: transform .25s ease;
    line-height: 1;
  }

  #ProductDetails-{{ section.id }} .elsis-faq-a {
    max-height: 0;
    overflow: hidden;
    transition: max-height .3s ease;
  }

  #ProductDetails-{{ section.id }} .elsis-faq-a-inner {
    padding-bottom: 20px;
    font-size: 15px;
    line-height: 1.6;
    color: #3D6344;
  }

  #ProductDetails-{{ section.id }} .elsis-faq-a p {
    font-size: 15px;
    line-height: 1.6;
    color: #3D6344;
    margin: 0 0 20px;
    text-align: left;
  }

  #ProductDetails-{{ section.id }} .elsis-faq-a ul {
    margin: 0 0 20px;
    padding-left: 20px;
    color: #3D6344;
    font-size: 15px;
  }

  #ProductDetails-{{ section.id }} .elsis-faq-a li {
    margin-bottom: 6px;
  }

  /* Nutrition Table Styling */
  #ProductDetails-{{ section.id }} .nutri-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 0 20px 0 !important;
  }

  #ProductDetails-{{ section.id }} .nutri-row {
    display: grid !important;
    grid-template-columns: 1.1fr 1fr !important;
    gap: 8px 20px !important;
    max-width: 480px !important;
    width: 100% !important;
    list-style: none !important;
    margin-bottom: 8px !important;
    align-items: baseline !important;
  }

  #ProductDetails-{{ section.id }} .nutri-label {
    font-size: 15px !important;
    color: #3D6344 !important;
    text-align: left !important;
  }

  #ProductDetails-{{ section.id }} .nutri-value {
    font-size: 15px !important;
    color: #3D6344 !important;
    text-align: left !important;
  }

  #ProductDetails-{{ section.id }} .nutri-header {
    font-family: var(--heading-font) !important;
    font-weight: 700 !important;
    color: #197D25 !important;
    font-size: 16px !important;
  }
{%- endstyle -%}



<section id="ProductDetails-{{ section.id }}">
  <div class="details-container">
    {%- if section.settings.title != blank -%}
      <h2 class="details-title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="details-accordion-list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'accordion' and block.settings.content != blank -%}
          <div class="elsis-faq-item" {{ block.shopify_attributes }}>
            <button type="button" class="elsis-faq-q" aria-expanded="false">
              {{ block.settings.title | escape }}
              <span class="elsis-faq-ic">+</span>
            </button>
            <div class="elsis-faq-a">
              <div class="elsis-faq-a-inner">
                {%- if block.settings.content contains '::' -%}
                  {%- assign list_parts = block.settings.content | split: '</ul>' -%}
                  {%- assign list_html = list_parts[0] | append: '</ul>' -%}
                  {%- assign extra_html = list_parts[1] -%}
                  
                  {%- assign li_items = list_html | split: '</li>' -%}
                  <ul class="nutri-list">
                    {%- for li_item in li_items -%}
                      {%- assign parts_li = li_item | split: '<li>' -%}
                      {%- if parts_li.size > 1 -%}
                        {%- assign clean_item = parts_li | last | strip -%}
                        {%- if clean_item contains '::' -%}
                          {%- assign row_parts = clean_item | split: '::' -%}
                          {%- assign label = row_parts[0] | strip_html | strip -%}
                          {%- assign value = row_parts[1] | strip_html | strip -%}
                          
                          {%- assign is_header = false -%}
                          {%- assign label_lower = label | downcase -%}
                          {%- if label_lower contains 'durchschnittswerte' or label_lower contains 'je 100' -%}
                            {%- assign is_header = true -%}
                          {%- endif -%}
                          
                          {%- assign is_indent = false -%}
                          {%- if label_lower contains 'davon' -%}
                            {%- assign is_indent = true -%}
                          {%- endif -%}
                          
                          <li class="nutri-row">
                            <span class="nutri-label{% if is_header %} nutri-header{% endif %}{% if is_indent %} nutri-indent{% endif %}">{{ label }}</span>
                            <span class="nutri-value{% if is_header %} nutri-header{% endif %}">{{ value }}</span>
                          </li>
                        {%- else -%}
                          <li>{{ clean_item }}</li>
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                  {%- if extra_html != blank -%}
                    {{ extra_html }}
                  {%- endif -%}
                {%- else -%}
                  {{ block.settings.content }}
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
function initDetailsAccordion() {
  const container = document.getElementById('ProductDetails-{{ section.id }}');
  if (!container) return;



  container.querySelectorAll('.elsis-faq-q').forEach(button => {
    if (button.dataset.faqInit) return;
    button.dataset.faqInit = 'true';

    button.addEventListener('click', function(e) {
      e.preventDefault();
      const content = button.nextElementSibling;
      const icon = button.querySelector('.elsis-faq-ic');
      const isExpanded = button.getAttribute('aria-expanded') === 'true';

      // Toggle state
      button.setAttribute('aria-expanded', !isExpanded);

      if (isExpanded) {
        content.style.maxHeight = '0px';
        if (icon) {
          icon.textContent = '+';
          icon.style.transform = 'none';
        }
      } else {
        content.style.maxHeight = content.scrollHeight + 'px';
        if (icon) {
          icon.textContent = '−';
          icon.style.transform = 'rotate(180deg)';
        }
      }
    });
  });
}

initDetailsAccordion();
document.addEventListener('DOMContentLoaded', initDetailsAccordion);
document.addEventListener('shopify:section:load', initDetailsAccordion);
</script>

{% schema %}
{
  "name": "Product Details Tabs",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "gut zu wissen"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#197D25"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab Title",
          "default": "Tab Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Tab Content",
          "info": "Connect this field to a product rich text metafield (dynamic source) or enter text."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Details Tabs",
      "blocks": [
        {
          "type": "accordion",
          "settings": {
            "title": "Zutaten"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Nährwerte"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Zubereitung & Aufbewahrung"
          }
        }
      ]
    }
  ]
}
{% endschema %}
